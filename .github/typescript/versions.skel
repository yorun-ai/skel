domain example.versions

data Order {
    id: int
}

actor ClientActor {}

actor ClientActorV1 {}

actor ClientActorV2 {}

actor ClientActorV10 {}

api service OrderApiService {
    for ClientActor
    auth required
    method get {
        input { id: int }
        output Order
    }
}

api service OrderApiServiceV1 {
    for ClientActorV1
    auth required
    method get {
        input { id: int }
        output Order
    }
}

api service OrderApiServiceV2 {
    for ClientActorV2
    auth required
    method get {
        input { id: int }
        output Order
    }
}

api service OrderApiServiceV10 {
    for ClientActorV10
    auth required
    method get {
        input { id: int }
        output Order
    }
}
